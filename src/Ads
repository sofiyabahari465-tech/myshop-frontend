app.post(
  '/api/products/upload',
  upload.single('file'),
  (req, res) => {
    if (!req.file) {
      return res.status(400).json({
        success: false,
        error: 'فایل اکسل انتخاب نشده است.',
      });
    }

    try {
      const workbook = XLSX.readFile(req.file.path);
      const sheetName = workbook.SheetNames[0];
      const sheet = workbook.Sheets[sheetName];

      const rows = XLSX.utils.sheet_to_json(sheet, {
        defval: '',
      });

      const importedProducts = rows
        .map((row, index) => {
          const name = cleanText(
            getValue(row, [
              'name',
              'Name',
              'نام',
              'نام محصول',
              'عنوان',
              'عنوان محصول',
            ]),
            'بدون نام',
          );

          const price = getNumber(
            getValue(row, [
              'price',
              'Price',
              'قیمت',
              'قیمت اصلی',
              'قیمت (تومان)',
              'قیمت واحد',
              'قیمت فروش',
            ]),
          );

          const category = cleanText(
            getValue(row, [
              'category',
              'Category',
              'دسته‌بندی',
              'دسته بندی',
            ]),
            'عمومی',
          );

          const stock = getNumber(
            getValue(row, [
              'stock',
              'Stock',
              'موجودی',
              'تعداد',
            ]),
          );

          return {
            id: `${Date.now()}-${index}-${Math.random()
              .toString(36)
              .slice(2, 8)}`,
            name,
            price,
            category,
            stock,
            updatedAt: new Date().toISOString(),
          };
        })
        .filter((product) => product.name !== 'بدون نام');

      const existingProducts = readProducts();

      const newProducts = importedProducts.filter(
        (importedProduct) => {
          return !existingProducts.some((existingProduct) => {
            return (
              existingProduct.name === importedProduct.name &&
              Number(existingProduct.price) ===
                Number(importedProduct.price)
            );
          });
        },
      );

      const duplicateCount =
        importedProducts.length - newProducts.length;

      const allProducts = [...existingProducts, ...newProducts];

      writeProducts(allProducts);
      synchronizeWarehouseWithProducts();

      return res.json({
        success: true,
        message:
          newProducts.length > 0
            ? `${newProducts.length} محصول جدید اضافه شد.`
            : 'همه محصولات فایل اکسل تکراری بودند.',
        count: newProducts.length,
        duplicate: duplicateCount,
        total: allProducts.length,
        data: newProducts,
      });
    } catch (error) {
      console.error('Excel upload error:', error);

      return res.status(500).json({
        success: false,
        error: `خطا در پردازش اکسل: ${error.message}`,
      });
    } finally {
      if (req.file?.path && fs.existsSync(req.file.path)) {
        fs.unlinkSync(req.file.path);
      }
    }
  },
);



app.put('/api/products/:id', (req, res) => {
  try {
    const products = readProducts();

    const productIndex = products.findIndex((product) => {
      return sameValue(product.id, req.params.id);
    });

    if (productIndex === -1) {
      return res.status(404).json({
        success: false,
        error: 'محصول یافت نشد.',
      });
    }

    const previousProduct = products[productIndex];

    products[productIndex] = {
      ...previousProduct,
      ...req.body,
      id: previousProduct.id,
      name:
        req.body.name !== undefined
          ? cleanText(req.body.name, previousProduct.name)
          : previousProduct.name,
      price:
        req.body.price !== undefined
          ? getNumber(req.body.price)
          : getNumber(previousProduct.price),
      category:
        req.body.category !== undefined
          ? cleanText(req.body.category, 'عمومی')
          : previousProduct.category || 'عمومی',
      stock:
        req.body.stock !== undefined
          ? getNumber(req.body.stock)
          : getNumber(previousProduct.stock),
      description:
        req.body.description !== undefined
          ? cleanText(req.body.description)
          : previousProduct.description || '',
      updatedAt: new Date().toISOString(),
    };

    writeProducts(products);

    const warehouse = readWarehouse();

    const warehouseIndex = warehouse.findIndex((item) => {
      return sameValue(item.productId, previousProduct.id);
    });

    if (warehouseIndex !== -1) {
      warehouse[warehouseIndex] = {
        ...warehouse[warehouseIndex],
        productName: products[productIndex].name,
        category: products[productIndex].category,
        quantity:
          req.body.stock !== undefined
            ? getNumber(req.body.stock)
            : getNumber(warehouse[warehouseIndex].quantity),
        updatedAt: new Date().toISOString(),
      };

      writeWarehouse(warehouse);
    } else {
      synchronizeWarehouseWithProducts();
    }

    return res.json({
      success: true,
      data: products[productIndex],
    });
  } catch (error) {
    return res.status(500).json({
      success: false,
      error: error.message,
    });
  }
});

