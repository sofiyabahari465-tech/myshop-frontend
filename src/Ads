      }

      if (!reason) {
        return res.status(400).json({
          success: false,
          error: 'دلیل مرجوعی را وارد کنید.',
        });
      }

      const returnRequests = readReturnRequests();

      const now = new Date().toISOString();

      const newReturnRequest = {
