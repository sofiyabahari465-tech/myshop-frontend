const toEnglishDigits = (value) => {
  if (value === null || value === undefined) {
    return '';
  }

  return String(value)
    .replace(/[۰-۹]/g, (digit) => {
      return String('۰۱۲۳۴۵۶۷۸۹'.indexOf(digit));
    })
    .replace(/[٠-٩]/g, (digit) => {
      return String('٠١٢٣٤٥٦٧٨٩'.indexOf(digit));
    });
};

const normalizeValue = (value) => {
  return toEnglishDigits(value).trim();
};

const sameValue = (firstValue, secondValue) => {
  const first = normalizeValue(firstValue);
  const second = normalizeValue(secondValue);

  return Boolean(first && second && first === second);
};

const createRandomId = () => {
  return `${Date.now()}-${Math.random()
    .toString(36)
    .slice(2, 8)}`;
};

const getNextRepresentativeId = (representatives) => {
  const numericIds = representatives
    .map((representative) => {
      const id = Number(normalizeValue(representative.id));

      return Number.isInteger(id) && id > 0 ? id : 0;
    })
    .filter((id) => id > 0);

  const maximumId =
    numericIds.length > 0 ? Math.max(...numericIds) : 0;

  return String(maximumId + 1);
};

const getNumber = (value) => {
  const normalized = toEnglishDigits(value)
    .replace(/[,٬،\s]/g, '')
    .replace(/[^\d.-]/g, '');

  const result = Number(normalized);

  return Number.isFinite(result) ? result : 0;
};

const getPositiveNumber = (value) => {
  const result = getNumber(value);

  return result > 0 ? result : 0;
};

const cleanText = (value, fallback = '') => {
  const result = String(value ?? '').trim();

  return result || fallback;
};

const normalizeJalaliDate = (value) => {
  const normalized = toEnglishDigits(value)
    .replace(/-/g, '/')
    .replace(/[^\d/]/g, '');

  const digits = normalized.replace(/\//g, '').slice(0, 8);

  if (digits.length <= 4) {
    return digits;
  }

  if (digits.length <= 6) {
    return `${digits.slice(0, 4)}/${digits.slice(4)}`;
  }

  return `${digits.slice(0, 4)}/${digits.slice(4, 6)}/${digits.slice(
    6,
    8,
  )}`;
};

const isValidJalaliDate = (value) => {
  return /^1[34]\d{2}\/(0[1-9]|1[0-2])\/(0[1-9]|[12]\d|3[01])$/.test(
    value,
  );
};

const getValue = (row, keys) => {
  for (const key of keys) {
    if (
      row[key] !== undefined &&
      row[key] !== null &&
      String(row[key]).trim() !== ''
    ) {
      return row[key];
    }
  }

  return '';
};

const getFileIcon = (fileName) => {
  const extension = fileName.split('.').pop()?.toLowerCase() || '';

  if (['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(extension)) {
    return '🖼️';
  }

  if (extension === 'pdf') {
    return '📕';
  }

  if (['doc', 'docx'].includes(extension)) {
    return '📘';
  }

  if (['xls', 'xlsx'].includes(extension)) {
    return '📗';
  }

  if (['zip', 'rar'].includes(extension)) {
    return '📦';
  }

  return '📄';
};

const fillShipmentRepresentative = (shipment, representatives) => {
  const shipmentRepresentativeId = normalizeValue(
    shipment.representativeId,
  );

  const shipmentRepresentativeCode = normalizeValue(
    shipment.representativeCode,
  );

  const representative = representatives.find((item) => {
    return (
      sameValue(item.id, shipmentRepresentativeId) ||
      sameValue(item.code, shipmentRepresentativeCode)
    );
  });

  if (!representative) {
    return shipment;
  }

  return {
    ...shipment,
    representativeId:
      shipmentRepresentativeId ||
      String(representative.id || '').trim(),
    representativeName:
      String(shipment.representativeName || '').trim() ||
      String(representative.name || '').trim(),
    representativeCode:
      shipmentRepresentativeCode ||
      String(representative.code || '').trim(),
    representativeCity:
      String(shipment.representativeCity || '').trim() ||
      String(representative.city || '').trim(),
  };
};

