const getRepresentativeFilePath = (representativeId, fileName) => {
  const representativeDirectory = path.resolve(
    REPRESENTATIVES_DIR,
    String(representativeId),
  );

  const filePath = path.resolve(
    representativeDirectory,
    String(fileName),
  );

  if (!filePath.startsWith(`${representativeDirectory}${path.sep}`)) {
    return null;
  }

  return filePath;
};

app.get('/api/representatives/:id/files', (req, res) => {
  try {
    const representativeId = req.params.id;

    const representativeDirectory = path.join(
      REPRESENTATIVES_DIR,
      representativeId,
    );

    if (!fs.existsSync(representativeDirectory)) {
      return res.json({
        success: true,
        files: [],
      });
    }

    const invalidFiles = [
      'favicon.svg',
      'favicon.ico',
      '.DS_Store',
      'Thumbs.db',
      'desktop.ini',
    ];

    const allowedExtensions = [
      'jpg',
      'jpeg',
      'png',
      'gif',
      'webp',
      'pdf',
      'doc',
      'docx',
      'xls',
      'xlsx',
      'zip',
      'rar',
    ];

    const files = fs
      .readdirSync(representativeDirectory)
      .filter((fileName) => {
        const extension =
          fileName.split('.').pop()?.toLowerCase() || '';

        return (
          !fileName.startsWith('.') &&
          !fileName.endsWith('.tmp') &&
          !invalidFiles.includes(fileName) &&
          allowedExtensions.includes(extension)
        );
      })
      .map((fileName, index) => {
        const filePath = path.join(
          representativeDirectory,
          fileName,
        );

        const stats = fs.statSync(filePath);

        return {
          id: `${representativeId}-${index}-${fileName}`,
          name: fileName,
          size: `${(stats.size / 1024).toFixed(1)} KB`,
          uploadedAt: new Date(
            stats.mtime,
          ).toLocaleDateString('fa-IR'),
          representativeId,
          icon: getFileIcon(fileName),
        };
      });

    return res.json({
      success: true,
      files,
    });
  } catch (error) {
    return res.status(500).json({
      success: false,
      error: error.message,
    });
  }
});

