app.post(
  '/api/representatives/:id/warehouse/movements',
  (req, res) => {
    try {
      const representativeId = normalizeValue(req.params.id);

      const representatives = readRepresentatives();

      const representative = representatives.find((item) => {
        return sameValue(item.id, representativeId);
      });

      if (!representative) {
        return res.status(404).json({
          success: false,
          error: 'نماینده پیدا نشد.',
        });
      }

      const type = req.body.type === 'out' ? 'out' : 'in';

      const productId = normalizeValue(req.body.productId);

      const quantity = getPositiveNumber(req.body.quantity);

      const unitPrice =
        req.body.unitPrice !== undefined
          ? getNumber(req.body.unitPrice)
          : 0;

      const minimumStock =
        req.body.minimumStock !== undefined
          ? getNumber(req.body.minimumStock)
          : 5;

      const reason = cleanText(
        req.body.reason,
        type === 'in'
          ? 'ارسال کالا به نماینده'
          : 'خروج کالا از انبار نماینده',
      );

      const description = cleanText(req.body.description);

      if (!productId) {
        return res.status(400).json({
          success: false,
          error: 'محصول انتخاب نشده است.',
        });
      }

      if (!quantity) {
        return res.status(400).json({
          success: false,
          error: 'تعداد باید بیشتر از صفر باشد.',
        });
      }

      if (unitPrice < 0 || minimumStock < 0) {
        return res.status(400).json({
          success: false,
          error:
            'قیمت و حداقل موجودی نمی‌توانند منفی باشند.',
        });
      }

      const products = readProducts();

      const product = products.find((item) => {
        return sameValue(item.id, productId);
      });

      if (!product) {
        return res.status(404).json({
          success: false,
          error: 'محصول انتخاب‌شده پیدا نشد.',
        });
      }

      const warehouses = readRepresentativeWarehouses();

      let warehouseIndex = warehouses.findIndex((warehouse) => {
        return sameValue(
          warehouse.representativeId,
          representativeId,
        );
      });

      if (warehouseIndex === -1) {
        warehouses.push(
          createRepresentativeWarehouse(representativeId),
        );

        warehouseIndex = warehouses.length - 1;
      }

      const warehouse = warehouses[warehouseIndex];

      warehouse.items = Array.isArray(warehouse.items)
        ? warehouse.items
        : [];

      warehouse.movements = Array.isArray(warehouse.movements)
        ? warehouse.movements
        : [];

      let itemIndex = warehouse.items.findIndex((item) => {
        return sameValue(item.productId, productId);
      });

      if (type === 'in') {
        const selectedUnitPrice =
          unitPrice > 0 ? unitPrice : getNumber(product.price);

        if (itemIndex === -1) {
          const newItem = {
            id: createRandomId(),
            productId: String(product.id),
            productName: cleanText(product.name, 'بدون نام'),
            quantity,
            unitPrice: selectedUnitPrice,
            totalPrice: quantity * selectedUnitPrice,
            minimumStock,
            status: getRepresentativeWarehouseStatus(
              quantity,
              minimumStock,
            ),
            lastUpdated: new Date().toISOString(),
          };

          warehouse.items.push(newItem);

          itemIndex = warehouse.items.length - 1;
        } else {
          const currentItem = warehouse.items[itemIndex];

          const nextQuantity =
            getNumber(currentItem.quantity) + quantity;

          const nextUnitPrice =
            unitPrice > 0
              ? unitPrice
              : getNumber(currentItem.unitPrice) ||
                getNumber(product.price);

          warehouse.items[itemIndex] = {
            ...currentItem,
            productId: String(product.id),
            productName: cleanText(product.name, 'بدون نام'),
            quantity: nextQuantity,
            unitPrice: nextUnitPrice,
            totalPrice: nextQuantity * nextUnitPrice,
            minimumStock,
            status: getRepresentativeWarehouseStatus(
              nextQuantity,
              minimumStock,
            ),
            lastUpdated: new Date().toISOString(),
          };
        }
      } else {
        if (itemIndex === -1) {
          return res.status(400).json({
            success: false,
            error: 'این کالا در انبار نماینده وجود ندارد.',
          });
        }

        const currentItem = warehouse.items[itemIndex];

        const currentQuantity = getNumber(currentItem.quantity);

        if (quantity > currentQuantity) {
          return res.status(400).json({
            success: false,
            error: `موجودی کافی نیست. موجودی فعلی: ${currentQuantity}`,
          });
        }

        const nextQuantity = currentQuantity - quantity;

        warehouse.items[itemIndex] = {
          ...currentItem,
          quantity: nextQuantity,
          totalPrice:
            nextQuantity * getNumber(currentItem.unitPrice),
          status: getRepresentativeWarehouseStatus(
            nextQuantity,
            currentItem.minimumStock,
          ),
          lastUpdated: new Date().toISOString(),
        };
      }

      const savedItem = warehouse.items[itemIndex];

      const newMovement = {
        id: createRandomId(),
        representativeId: String(representative.id),
        productId: String(product.id),
        productName: cleanText(product.name, 'بدون نام'),
        type,
        quantity,
        unitPrice: getNumber(savedItem?.unitPrice),
        reason,
        description,
        createdAt: new Date().toISOString(),
      };

      warehouse.movements.unshift(newMovement);

      warehouse.updatedAt = new Date().toISOString();

      warehouses[warehouseIndex] = warehouse;

      writeRepresentativeWarehouses(warehouses);

      updateRepresentativeWarehouseSummary(
        representativeId,
        warehouse,
      );

      return res.status(201).json({
        success: true,
        message:
          type === 'in'
            ? 'کالا با موفقیت به انبار نماینده ارسال شد.'
            : 'خروج کالا از انبار نماینده ثبت شد.',
        data: {
          item: savedItem,
          movement: newMovement,
        },
      });
    } catch (error) {
      console.error('خطا در ثبت گردش انبار نماینده:', error);

      return res.status(500).json({
        success: false,
        error:
          error.message || 'خطا در ثبت گردش انبار نماینده.',
      });
    }
  },
);

