const getRepresentativeWarehouseStatus = (
  quantity,
  minimumStock,
) => {
  const safeQuantity = getNumber(quantity);
  const safeMinimumStock = getNumber(minimumStock);

  if (safeQuantity <= 0) {
    return 'out';
  }

  if (safeQuantity <= safeMinimumStock) {
    return 'low';
  }

  return 'normal';
};

const createRepresentativeWarehouse = (representativeId) => {
  return {
    representativeId: String(representativeId),
    items: [],
    movements: [],
    updatedAt: new Date().toISOString(),
  };
};

const updateRepresentativeWarehouseSummary = (
  representativeId,
  warehouse,
) => {
  const representatives = readRepresentatives();

  const representativeIndex = representatives.findIndex(
    (representative) => {
      return sameValue(representative.id, representativeId);
    },
  );

  if (representativeIndex === -1) {
    return;
  }

  const items = Array.isArray(warehouse.items)
    ? warehouse.items
    : [];

  const totalItems = items.reduce((sum, item) => {
    return sum + getNumber(item.quantity);
  }, 0);

  const totalValue = items.reduce((sum, item) => {
    return sum + getNumber(item.totalPrice);
  }, 0);

  representatives[representativeIndex] = {
    ...representatives[representativeIndex],
    storeItemsCount: totalItems,
    storeItemsTotalValue: totalValue,
    updatedAt: new Date().toISOString(),
  };

  writeRepresentatives(representatives);
};

