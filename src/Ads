const createWarehouseItem = (product, minimumStock = 5) => {
  return {
    productId: String(product.id),
    productName: cleanText(product.name, 'بدون نام'),
    category: cleanText(product.category, 'عمومی'),
    quantity: getNumber(product.stock),
    minimumStock: Math.max(0, getNumber(minimumStock)),
    updatedAt: new Date().toISOString(),
  };
};

const synchronizeWarehouseWithProducts = () => {
  const products = readProducts();
  const currentWarehouse = readWarehouse();

  const synchronizedWarehouse = products.map((product) => {
    const existingWarehouseItem = currentWarehouse.find((item) => {
      return sameValue(item.productId, product.id);
    });

    if (!existingWarehouseItem) {
      return createWarehouseItem(product);
    }

    return {
      ...existingWarehouseItem,
      productId: String(product.id),
      productName: cleanText(product.name, 'بدون نام'),
      category: cleanText(product.category, 'عمومی'),
      quantity: getNumber(existingWarehouseItem.quantity),
      minimumStock: Math.max(
        0,
        getNumber(existingWarehouseItem.minimumStock),
      ),
      updatedAt:
        existingWarehouseItem.updatedAt ||
        new Date().toISOString(),
    };
  });

  const shouldSave =
    synchronizedWarehouse.length !== currentWarehouse.length ||
    synchronizedWarehouse.some((item, index) => {
      return (
        JSON.stringify(item) !==
        JSON.stringify(currentWarehouse[index])
      );
    });

  if (shouldSave) {
    writeWarehouse(synchronizedWarehouse);
  }

  return synchronizedWarehouse;
};

