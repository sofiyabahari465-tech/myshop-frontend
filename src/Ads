app.post('/api/warehouse/movements', (req, res) => {
  try {
    const productId = normalizeValue(req.body.productId);
    const type = req.body.type === 'out' ? 'out' : 'in';
    const quantity = getPositiveNumber(req.body.quantity);

    const minimumStock =
      req.body.minimumStock !== undefined
        ? getNumber(req.body.minimumStock)
        : 5;

    const reason = cleanText(
      req.body.reason,
      type === 'in' ? 'ورود کالا' : 'خروج کالا',
    );

    const description = cleanText(req.body.description);

    if (!productId) {
      return res.status(400).json({
        success: false,
        error: 'لطفاً محصول را انتخاب کنید.',
      });
    }

    if (!quantity) {
      return res.status(400).json({
        success: false,
        error: 'تعداد باید بیشتر از صفر باشد.',
      });
    }

    const products = readProducts();

    const productIndex = products.findIndex((product) => {
      return sameValue(product.id, productId);
    });

    if (productIndex === -1) {
      return res.status(404).json({
        success: false,
        error: 'محصول انتخاب‌شده پیدا نشد.',
      });
    }

    const product = products[productIndex];
    const warehouse = synchronizeWarehouseWithProducts();

    let warehouseIndex = warehouse.findIndex((item) => {
      return sameValue(item.productId, productId);
    });

    if (warehouseIndex === -1) {
      warehouse.push(createWarehouseItem(product, minimumStock));

      warehouseIndex = warehouse.length - 1;
    }

    const currentWarehouseItem = warehouse[warehouseIndex];

    const currentQuantity = getNumber(
      currentWarehouseItem.quantity,
    );

    if (type === 'out' && quantity > currentQuantity) {
      return res.status(400).json({
        success: false,
        error: `موجودی کافی نیست. موجودی فعلی این کالا: ${currentQuantity}`,
      });
    }

    const nextQuantity =
      type === 'in'
        ? currentQuantity + quantity
        : currentQuantity - quantity;

    warehouse[warehouseIndex] = {
      ...currentWarehouseItem,
      productId: String(product.id),
      productName: cleanText(product.name, 'بدون نام'),
      category: cleanText(product.category, 'عمومی'),
      quantity: nextQuantity,
      minimumStock: Math.max(0, getNumber(minimumStock)),
      updatedAt: new Date().toISOString(),
    };

    products[productIndex] = {
      ...product,
      stock: nextQuantity,
      updatedAt: new Date().toISOString(),
    };

    const movements = readWarehouseMovements();

    const newMovement = {
      id: createRandomId(),
      productId: String(product.id),
      productName: cleanText(product.name, 'بدون نام'),
      type,
      quantity,
      reason,
      description,
      createdAt: new Date().toISOString(),
    };

    movements.push(newMovement);

    writeWarehouse(warehouse);
    writeWarehouseMovements(movements);
    writeProducts(products);

    return res.status(201).json({
      success: true,
      message:
        type === 'in'
          ? 'ورود کالا با موفقیت ثبت شد.'
          : 'خروج کالا با موفقیت ثبت شد.',
      data: {
        movement: newMovement,
        inventory: warehouse[warehouseIndex],
      },
    });
  } catch (error) {
    return res.status(500).json({
      success: false,
      error: error.message || 'خطا در ثبت گردش انبار.',
    });
  }
});

