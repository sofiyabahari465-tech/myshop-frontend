      if (duplicateCode) {
        return res.status(400).json({
          success: false,
          error:
            'این کد نمایندگی متعلق به نماینده دیگری است.',
        });
      }
    }

    const nextDepositAmount =
      req.body.depositAmount !== undefined
        ? getNumber(req.body.depositAmount)
        : getNumber(currentRepresentative.depositAmount);

    const nextGuaranteeCheck =
      req.body.guaranteeCheck !== undefined
        ? getNumber(req.body.guaranteeCheck)
        : getNumber(currentRepresentative.guaranteeCheck);

    const nextStartDate =
      req.body.startDate !== undefined
        ? normalizeJalaliDate(req.body.startDate)
        : currentRepresentative.startDate || '';

    if (nextStartDate && !isValidJalaliDate(nextStartDate)) {
      return res.status(400).json({
        success: false,
        error:
          'تاریخ قرارداد باید به صورت شمسی و با فرمت 1405/07/02 باشد.',
      });
    }

    representatives[representativeIndex] = {
      ...currentRepresentative,
      ...req.body,
      id: currentRepresentative.id,
      code: newCode || currentRepresentative.code || '',
      startDate: nextStartDate,
      depositAmount: String(nextDepositAmount),
      guaranteeCheck: String(nextGuaranteeCheck),
      totalFinancialCommitment: String(
        nextDepositAmount + nextGuaranteeCheck,
      ),
      orders:
        req.body.orders !== undefined
          ? getNumber(req.body.orders)
          : getNumber(currentRepresentative.orders),
      shipmentsCount:
        req.body.shipmentsCount !== undefined
          ? getNumber(req.body.shipmentsCount)
          : getNumber(currentRepresentative.shipmentsCount),
      storeItemsCount:
        req.body.storeItemsCount !== undefined
          ? getNumber(req.body.storeItemsCount)
          : getNumber(currentRepresentative.storeItemsCount),
      storeItemsTotalValue:
        req.body.storeItemsTotalValue !== undefined
          ? getNumber(req.body.storeItemsTotalValue)
          : getNumber(currentRepresentative.storeItemsTotalValue),
      last10DaysSales:
        req.body.last10DaysSales !== undefined
          ? getNumber(req.body.last10DaysSales)
          : getNumber(currentRepresentative.last10DaysSales),
      averageSales:
        req.body.averageSales !== undefined
          ? getNumber(req.body.averageSales)
          : getNumber(currentRepresentative.averageSales),
      returnRequestsCount:
        currentRepresentative.returnRequestsCount ?? 0,
      status:
        req.body.status === 'inactive'
          ? 'inactive'
          : req.body.status === 'active'
            ? 'active'
            : currentRepresentative.status || 'active',
      updatedAt: new Date().toISOString(),
    };

    writeRepresentatives(representatives);

    return res.json({
      success: true,
      data: representatives[representativeIndex],
    });
  } catch (error) {
    return res.status(500).json({
      success: false,
      error: error.message || 'خطا در ویرایش نماینده.',
    });
  }
});

